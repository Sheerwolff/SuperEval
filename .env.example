# Leave OPENAI_API_KEY empty to run fully on the simulated agent (free).
OPENAI_API_KEY=
AGENT_MODEL=gpt-5-mini
JUDGE_MODEL=gpt-5-mini
REASONING_EFFORT=low

# SQLite by default; set a Postgres URL (e.g. Neon) in production
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

DAILY_BUDGET_USD=2.0
RATE_LIMIT_PER_HOUR=30
JUDGE_SAMPLE_RATE=1.0
FRESHNESS_SLA_HOURS=36
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# "Let's connect" card. WhatsApp: international format, digits only (e.g. 9725XXXXXXXX). Not committed.
# CONTACT_WHATSAPP=
